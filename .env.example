# Copy to .env locally or enter values in your server host's secret settings.
# Never commit .env or paste secret keys in chat.
PORT=3000
DATA_DIR=.data
PUBLIC_BASE_URL=https://your-service.example
SALES_ENABLED=false
POLICIES_APPROVED=false
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
RESEND_API_KEY=
MAIL_FROM=
SELLER_NAME=
SELLER_BUSINESS_ID=
SELLER_CONTACT=
SELLER_ADDRESS=
# Use SALES_ENABLED=test with test_ck_/test_sk_ credentials for provider tests.
# Only set SALES_ENABLED=true after provider review, verified domain,
# seller details, privacy/transfer/retention policies and refund operations.

# Operations: set these only in the host's secure environment settings.
ADMIN_ACCESS_TOKEN=
ORDER_DATA_KEY=
# Optional AI interpretation; rules is the truthful default.
REPORT_ENGINE=rules
AI_PROVIDER_KEY=
AI_MODEL=
